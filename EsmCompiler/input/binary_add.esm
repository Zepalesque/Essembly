// binary 8-bit adder
let a: u8; // init local var a
let b: u8; // init local var b

alloc inputStr: &str = "Please input a number.\n";
push inputStr;
print &str;
free inputStr;

// stays longer
alloc moreInputs: &str = "Please input another number.\n";
alloc sum: &str = "Sum: ";
alloc continue: &str = "Want to continue? Press 'y'!\n";

// take input a
push input u8;
store a;

#add_loop:
     push moreInputs;
     print &str;
    
    // take input b
    push input u8;
    store b;
    
    // arithmetic operations, yippee!!!!
    push b; // -> b
    push a; // -> a, b
    operate u8 binary +; // -> a+b
    store a; // ->

    
    push sum;
    print &str;
    
    push a;
    print u8;
    
    push u8 '\n';
    print ascii;
    
    push continue;
    print &str;
    
    push input ascii;
    push u8 'y';
    operate u8 ^;
    
goto #add_loop if zero;

free continue;
free sum;
free moreInputs;
push u8 0;
exit;